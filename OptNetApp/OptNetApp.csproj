<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>$(MSBuildProjectName.Replace("App", ""))</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptNetLib\OptNetLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OptNetLib">
      <HintPath>..\OptNetLib\bin\Debug\net9.0\OptNetLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Import Project="..\WinformSrc\WinformSrc.projitems" Label="Shared" />

</Project>